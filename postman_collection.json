              "raw": "{\n  \"title\": \"Cotton Kurta\",\n  \"description\": \"Sample product\",\n  \"price\": 1999,\n  \"discountedPrice\": 1499,\n  \"discountPersent\": 25,\n  \"quantity\": 50,\n  \"brand\": \"Demo\",\n  \"color\": \"Blue\",\n  \"size\": [\n    {\n      \"name\": \"M\",\n      \"quantity\": 20\n    },\n    {\n      \"name\": \"L\",\n      \"quantity\": 30\n    }\n  ],\n  \"imageUrl\": \"https://example.com/kurta.jpg\",\n  \"topLavelCategory\": \"men\",\n  \"secondLavelCategory\": \"clothing\",\n  \"thirdLavelCategory\": \"mens_kurta\"\n}",
              "options": {
