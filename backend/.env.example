# Copy this file to ".env" in the backend folder and fill in your values.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ecommerce
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# At least 32 random characters
JWT_SECRET=change-this-to-a-long-random-string-32chars-min

# Optional: Razorpay TEST keys, needed only for the payment step
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
